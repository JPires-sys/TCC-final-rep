<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/slate_50" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="28dp" android:paddingBottom="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="MEU ESPAÇO" android:textSize="12sp" android:letterSpacing="0.12"
            android:textColor="@color/brand_blue" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/txtNomeDetalhes" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Olá!" android:textSize="28sp"
            android:fontFamily="sans-serif-medium" android:textColor="@color/slate_900" />
        <TextView android:id="@+id/txtEmailDetalhes" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textSize="13sp" android:textColor="@color/slate_500" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:layout_marginBottom="24dp"
            android:text="Seu dia digital, com mais equilíbrio."
            android:textColor="@color/slate_700" android:textSize="16sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnChatbox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true"
            android:contentDescription="Conversar com o Chatbox. Um espaço para falar sobre o seu dia."
            app:cardCornerRadius="20dp" app:cardElevation="0dp"
            app:cardBackgroundColor="@color/brand_blue"
            app:strokeColor="@color/brand_blue" app:strokeWidth="1dp"
            app:rippleColor="#33FFFFFF">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp"
                android:importantForAccessibility="noHideDescendants">
                <ImageView android:layout_width="48dp" android:layout_height="48dp"
                    android:padding="12dp" android:src="@drawable/chatbox_ic_chat"
                    android:background="@drawable/bg_home_icon_primary"
                    app:tint="@color/white" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="14dp" android:layout_marginEnd="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Conversar com o Chatbox" android:textSize="17sp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/white" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="Um espaço para falar sobre o seu dia." android:textSize="13sp"
                        android:lineSpacingExtra="2dp" android:textColor="#E3EDFF" />
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="24dp"
                    android:src="@drawable/ic_home_chevron" app:tint="@color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnVerHistorico"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true"
            android:contentDescription="Meu tempo de tela. Veja os apps usados e o tempo em cada um."
            app:cardCornerRadius="20dp" app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/slate_200" app:strokeWidth="1dp"
            app:rippleColor="#221A56DB">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp"
                android:importantForAccessibility="noHideDescendants">
                <ImageView android:layout_width="48dp" android:layout_height="48dp"
                    android:padding="12dp" android:src="@drawable/ic_home_history"
                    android:background="@drawable/bg_home_icon"
                    app:tint="@color/brand_blue" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="14dp" android:layout_marginEnd="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Meu tempo de tela" android:textSize="17sp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/slate_900" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="Veja os apps usados e o tempo em cada um." android:textSize="13sp"
                        android:lineSpacingExtra="2dp" android:textColor="@color/slate_500" />
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="24dp"
                    android:src="@drawable/ic_home_chevron" app:tint="@color/slate_400" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnVerAlertasFilho"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true"
            android:contentDescription="Meus alertas. Confira avisos e lembretes do responsável."
            app:cardCornerRadius="20dp" app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/slate_200" app:strokeWidth="1dp"
            app:rippleColor="#221A56DB">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp"
                android:importantForAccessibility="noHideDescendants">
                <ImageView android:layout_width="48dp" android:layout_height="48dp"
                    android:padding="12dp" android:src="@drawable/ic_home_bell"
                    android:background="@drawable/bg_home_icon"
                    app:tint="@color/brand_blue" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="14dp" android:layout_marginEnd="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Meus alertas" android:textSize="17sp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/slate_900" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="Confira avisos e lembretes do responsável." android:textSize="13sp"
                        android:lineSpacingExtra="2dp" android:textColor="@color/slate_500" />
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="24dp"
                    android:src="@drawable/ic_home_chevron" app:tint="@color/slate_400" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnAnaliseIA"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true"
            android:contentDescription="Entender meu uso. Receba sugestões da IA para sua rotina."
            app:cardCornerRadius="20dp" app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/slate_200" app:strokeWidth="1dp"
            app:rippleColor="#221A56DB">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp"
                android:importantForAccessibility="noHideDescendants">
                <ImageView android:layout_width="48dp" android:layout_height="48dp"
                    android:padding="12dp" android:src="@drawable/ic_home_insights"
                    android:background="@drawable/bg_home_icon"
                    app:tint="@color/brand_blue" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="14dp" android:layout_marginEnd="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Entender meu uso" android:textSize="17sp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/slate_900" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="Receba sugestões da IA para sua rotina." android:textSize="13sp"
                        android:lineSpacingExtra="2dp" android:textColor="@color/slate_500" />
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="24dp"
                    android:src="@drawable/ic_home_chevron" app:tint="@color/slate_400" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnVincularContas"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true"
            android:contentDescription="Vincular responsável. Conecte sua conta usando o ID recebido."
            app:cardCornerRadius="20dp" app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/slate_200" app:strokeWidth="1dp"
            app:rippleColor="#221A56DB">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp"
                android:importantForAccessibility="noHideDescendants">
                <ImageView android:layout_width="48dp" android:layout_height="48dp"
                    android:padding="12dp" android:src="@drawable/ic_home_link"
                    android:background="@drawable/bg_home_icon"
                    app:tint="@color/brand_blue" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="14dp" android:layout_marginEnd="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Vincular responsável" android:textSize="17sp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/slate_900" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="Conecte sua conta usando o ID recebido." android:textSize="13sp"
                        android:lineSpacingExtra="2dp" android:textColor="@color/slate_500" />
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="24dp"
                    android:src="@drawable/ic_home_chevron" app:tint="@color/slate_400" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRespostaIA" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" android:visibility="gone"
            app:cardCornerRadius="20dp" app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white" app:strokeColor="@color/slate_200" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Sua análise de uso" android:textSize="17sp" android:fontFamily="sans-serif-medium"
                    android:textColor="@color/brand_blue" />
                <ProgressBar android:id="@+id/progressBar" android:layout_width="28dp" android:layout_height="28dp"
                    android:layout_marginTop="12dp" android:visibility="gone" android:indeterminateTint="@color/brand_blue" />
                <TextView android:id="@+id/txtRespostaIA" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:lineSpacingExtra="4dp" android:textSize="15sp"
                    android:textColor="@color/slate_700" android:textIsSelectable="true" android:accessibilityLiveRegion="polite" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="CONTA E CONFIGURAÇÕES"
            android:textSize="11sp" android:letterSpacing="0.08" android:textColor="@color/slate_500" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAtivarAdmin"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:layout_marginTop="12dp" android:text="Concluir configuração" android:textAllCaps="false"
            android:textColor="@color/brand_blue" app:cornerRadius="16dp"
            app:strokeColor="@color/slate_200" app:icon="@drawable/ic_home_shield" app:iconTint="@color/brand_blue" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnLogout"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_marginTop="8dp" android:text="Sair da conta" android:textAllCaps="false"
            android:textColor="@color/slate_500" />
    </LinearLayout>
</ScrollView>
