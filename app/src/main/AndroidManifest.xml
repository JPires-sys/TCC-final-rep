<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE"
        tools:ignore="ProtectedPermissions" />

    <!-- Resolve nomes e ícones dos apps com tela inicial para o histórico. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Supervisionador">

        <service
            android:name=".funcionalidades.monitoramento.MonitoramentoService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.foreground_service_type" android:value="monitoring"/>
        </service>

        <service
            android:name=".alerta.comportamento.AlertListenerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.foreground_service_type" android:value="monitoring"/>
        </service>

        <service
            android:name=".funcionalidades.monitoramento.BloqueioAppAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false"
            android:label="EagleEyes Bloqueio">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name=".global.PolicyManagerReceiver"
            android:label="Segurança - Controle Parental"
            android:description="@string/device_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".funcionalidades.monitoramento.activity.BloqueioActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <activity
            android:name=".funcionalidades.monitoramento.activity.TentativaDesinstalacaoActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <activity android:name=".funcionalidades.historico.RelatorioFilhoActivity" android:exported="false" />

        <activity android:name=".cadastro.CadastroOpcoesActivity" android:exported="false" />
        <activity android:name=".filho.home.HomeFilhoActivity" android:exported="false" />
        <activity android:name=".pai.home.HomePaiActivity" android:exported="false" />
        <activity android:name=".vinculo.VinculoActivity" android:exported="false" />
        <activity android:name=".chat.ChatActivity" android:exported="false" android:theme="@style/Theme.Chatbox" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".pai.ListaFilhosActivity" android:exported="false" />
        <activity android:name=".cadastro.CadastroPaiActivity" android:exported="false" />
        <activity android:name=".cadastro.CadastroFilhoActivity" android:exported="false" />
        <activity android:name=".cadastro.CadastroActivity" android:exported="false" />

        <activity android:name=".filho.detalhes.DetalhesFilhoActivity" android:exported="false" />
        <activity android:name=".alerta.CriarAlertaActivity" android:exported="false" />
        <activity android:name=".alerta.activitiy.AlertasFilhoActivity" android:exported="false" />
        <activity android:name=".alerta.activitiy.AlertasActivity" android:exported="false" />
        <activity android:name=".funcionalidades.historico.CriarHistoricoActivity" android:exported="false" />
        <activity android:name=".funcionalidades.regra.CriarRegraActivity" android:exported="false" />
        <activity android:name=".funcionalidades.regra.GerenciarRegrasActivity" android:exported="false" />

        <activity
            android:name=".login.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
